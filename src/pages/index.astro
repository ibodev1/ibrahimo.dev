---
import { MAILTO, SITE_NAME } from "../constants/site";
import { socialMedias } from "../constants/social";
import Layout from "../layouts/layout.astro";
---

<Layout>
  <main>
    <div class="card">
      <h1>{SITE_NAME}</h1>
      <p class="subtitle">Software Developer</p>

      <nav aria-label="Social links" class="links">
        {socialMedias.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="link"
          >
            <span class="icon" aria-hidden="true" set:html={item.svg} />
            <span class="label">{item.title}</span>
            <svg class="arrow" aria-hidden="true" viewBox="0 0 24 24">
              <path d="M7 17 17 7M7 7h10v10" />
            </svg>
          </a>
        ))}
      </nav>

      <a href={MAILTO} class="contact">
        <svg class="mail" aria-hidden="true" viewBox="0 0 24 24">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        Contact Me
      </a>
    </div>
  </main>
</Layout>
